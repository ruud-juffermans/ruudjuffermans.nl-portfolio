<mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="OV Streaming Pipeline — Architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="26" width="1080" height="34" as="geometry"/></mxCell>
<mxCell id="sub" value="From two GTFS-realtime feeds to live delay aggregates: Kafka as the bus, a windowed processor, MinIO as a replayable archive, Postgres as the serving layer — thirteen containers, fully local." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="60" width="1440" height="24" as="geometry"/></mxCell>
<mxCell id="feed" value="&lt;b&gt;OVapi GTFS-RT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;vehiclePositions.pb&lt;br&gt;every 20 s&lt;br&gt;&lt;br&gt;tripUpdates.pb&lt;br&gt;every 60 s&lt;br&gt;&lt;br&gt;FULL_DATASET snapshots,&lt;br&gt;refreshed ~1× per minute&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="120" width="228" height="264" as="geometry"/></mxCell>
<mxCell id="prod" value="&lt;b&gt;producer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;parse protobuf&lt;br&gt;diff snapshots&lt;br&gt;+ heartbeat every 60 s&lt;br&gt;&lt;br&gt;backoff on HTTP 429&lt;br&gt;drop ghost positions&lt;br&gt;&lt;br&gt;~45% of entities&lt;br&gt;is suppressed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="336" y="120" width="240" height="264" as="geometry"/></mxCell>
<mxCell id="kafka" value="REDPANDA (KAFKA API)" style="swimlane;rounded=1;fillColor=none;strokeColor=#f59e0b;fontStyle=1;fontSize=12;startSize=26;html=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="636" y="120" width="288" height="360" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;vehicle_positions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;6 partitions · key = vehicle_id&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=none;strokeColor=#f59e0b;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="kafka"><mxGeometry x="24" y="46" width="240" height="79" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;arrival_predictions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;6 partitions · key = trip_id&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=none;strokeColor=#f59e0b;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="kafka"><mxGeometry x="24" y="139" width="240" height="79" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;dlq.vehicle_positions&lt;br&gt;dlq.arrival_predictions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;original bytes + error headers&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=none;strokeColor=#ef4444;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="kafka"><mxGeometry x="24" y="233" width="240" height="89" as="geometry"/></mxCell>
<mxCell id="t4" value="retention 24 h (DLQ 7 d) — the broker is a buffer, not an archive" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#94a3b8;fontStyle=2;strokeWidth=1.5;arcSize=6;" vertex="1" parent="kafka"><mxGeometry x="24" y="324" width="240" height="31" as="geometry"/></mxCell>
<mxCell id="proc" value="&lt;b&gt;processor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;tumbling windows of 5 min&lt;br&gt;per-partition watermarks&lt;br&gt;2 min allowed lateness&lt;br&gt;&lt;br&gt;count · mean · P90 · max · min&lt;br&gt;over 4 dimensions:&lt;br&gt;route · station · agency · network&lt;br&gt;&lt;br&gt;manual commit, after the upsert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="984" y="120" width="288" height="288" as="geometry"/></mxCell>
<mxCell id="arch" value="&lt;b&gt;archiver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;own consumer group&lt;br&gt;raw bytes, gzip JSON lines&lt;br&gt;commit only after a&lt;br&gt;successful put&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="984" y="480" width="288" height="168" as="geometry"/></mxCell>
<mxCell id="minio" value="&lt;b&gt;MinIO — raw-events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;topic/date/hour/p-offsets.jsonl.gz&lt;br&gt;&lt;br&gt;the replayable long-term archive&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="636" y="504" width="288" height="144" as="geometry"/></mxCell>
<mxCell id="pg" value="POSTGRES" style="swimlane;rounded=1;fillColor=none;strokeColor=#94a3b8;fontStyle=1;fontSize=12;startSize=26;html=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1332" y="120" width="300" height="360" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;delay_aggregates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;PK = (window_start, dimension,&lt;br&gt;dimension_id) — the idempotency key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="pg"><mxGeometry x="18" y="46" width="264" height="79" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;vehicle_latest · trip_delay_latest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;last-write-wins, guarded by observed_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="pg"><mxGeometry x="18" y="139" width="264" height="72" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;ref_agencies · ref_routes&lt;br&gt;ref_stops · ref_trips&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;static GTFS reference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="pg"><mxGeometry x="18" y="226" width="264" height="84" as="geometry"/></mxCell>
<mxCell id="p4" value="all times in UTC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#94a3b8;fontStyle=2;strokeWidth=1.5;arcSize=6;" vertex="1" parent="pg"><mxGeometry x="18" y="314" width="264" height="29" as="geometry"/></mxCell>
<mxCell id="gtfs" value="&lt;b&gt;gtfs-static&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;220 MB zip straight into COPY&lt;br&gt;staging + atomic swap&lt;br&gt;daily — 864k trips, 76k stops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1332" y="516" width="300" height="132" as="geometry"/></mxCell>
<mxCell id="dash" value="&lt;b&gt;dashboard (Streamlit + pydeck)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;live map · KPI tiles · worst routes and stations · network trend · distribution · health strip — refreshes every 10 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1248" y="720" width="384" height="132" as="geometry"/></mxCell>
<mxCell id="obs" value="OBSERVABILITY — Prometheus scrapes every service and Redpanda; Grafana serves a provisioned dashboard of 26 panels: throughput · consumer lag · watermark lag · DLQ rate · late events · processing time · state size · archive volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#6b7280;dashed=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="924" width="1584" height="96" as="geometry"/></mxCell>
<mxCell id="replaybox" value="REPLAY — make replay FROM= TO= runs archive files back through the same Pipeline class as the consumer (no second implementation), deduplicated on (topic, partition, offset).&lt;br&gt;make replay-dlq decodes dead letters with the current parser and injects the repaired ones back into the source topic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="720" width="1152" height="132" as="geometry"/></mxCell>
