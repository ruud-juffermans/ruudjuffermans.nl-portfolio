<mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="860" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="strafrecht-rag — Architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="26" width="1080" height="34" as="geometry"/></mxCell>
<mxCell id="sub" value="Two pipelines: offline builds the corpus (ingest → parse → chunk → embed → store), online answers a question (retrieve → rerank → threshold → LLM → verify). Everything runs locally." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="60" width="1440" height="24" as="geometry"/></mxCell>
<mxCell id="off" value="OFFLINE — BUILDING THE CORPUS" style="swimlane;rounded=1;fillColor=none;strokeColor=#94a3b8;fontStyle=1;fontSize=12;startSize=30;html=1;dashed=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="108" width="1656" height="360" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Rechtspraak.nl Open Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;search feed + content&lt;br&gt;open access, no key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="off"><mxGeometry x="24" y="53" width="228" height="108" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;ingest/client.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;paginates by date + area of law&lt;br&gt;rate limited · retries with backoff&lt;br&gt;resumable: existing files&lt;br&gt;are skipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="off"><mxGeometry x="288" y="53" width="240" height="108" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;data/raw/&amp;lt;ECLI&amp;gt;.xml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;1,906 rulings&lt;br&gt;not in git&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=none;strokeColor=#94a3b8;fontSize=12;fontColor=#6b7280;strokeWidth=1.5;arcSize=6;" vertex="1" parent="off"><mxGeometry x="564" y="53" width="204" height="108" as="geometry"/></mxCell>
<mxCell id="o4" value="&lt;b&gt;ingest/parser.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;XML → Uitspraak&lt;br&gt;sections + numbered paragraphs&lt;br&gt;bold headings become subsections&lt;br&gt;&lt;br&gt;one broken file = one error record,&lt;br&gt;never a crashed batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="off"><mxGeometry x="804" y="53" width="252" height="132" as="geometry"/></mxCell>
<mxCell id="o5" value="&lt;b&gt;index/chunker.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;560 characters, 120 overlap&lt;br&gt;never across a section boundary&lt;br&gt;overlap in whole paragraphs&lt;br&gt;&lt;br&gt;pure and deterministic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="off"><mxGeometry x="1092" y="53" width="240" height="132" as="geometry"/></mxCell>
<mxCell id="o6" value="&lt;b&gt;index/embeddings.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;multilingual MiniLM, 384d&lt;br&gt;ONNX, quantised, local&lt;br&gt;~13 chunks/s on a laptop CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="off"><mxGeometry x="1368" y="53" width="258" height="132" as="geometry"/></mxCell>
<mxCell id="onote" value="Reindexing skips unchanged rulings via a content fingerprint per ECLI; chunk_id = &quot;&amp;lt;ECLI&amp;gt;#position&quot;, so every write is an upsert." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#94a3b8;fontStyle=2;strokeWidth=1.5;arcSize=6;" vertex="1" parent="off"><mxGeometry x="288" y="216" width="1080" height="36" as="geometry"/></mxCell>
<mxCell id="o7" value="Corpus: criminal law, 1–15 March 2023 · 2024 · 2025 — 1,906 rulings, 0 parse errors, 124,952 chunks, 22 courts" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#6b7280;fontStyle=1;strokeWidth=1.5;arcSize=6;" vertex="1" parent="off"><mxGeometry x="288" y="264" width="1338" height="36" as="geometry"/></mxCell>
<mxCell id="store" value="&lt;b&gt;index/store.py — SQLite + NumPy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;metadata in tables · BM25 via FTS5 · vectors as one float32 matrix&lt;br&gt;exact cosine scan in a few milliseconds · one file, no service · 473 MB&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="564" y="504" width="624" height="132" as="geometry"/></mxCell>
<mxCell id="on" value="ONLINE — ANSWERING A QUESTION" style="swimlane;rounded=1;fillColor=none;strokeColor=#94a3b8;fontStyle=1;fontSize=12;startSize=30;html=1;dashed=1;fontColor=#3b82f6;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="684" width="1656" height="324" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;b&gt;question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;+ filters: court type,&lt;br&gt;court, date range&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="24" y="72" width="180" height="108" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;b&gt;retriever&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;cosine top-3k ⊕ BM25 top-3k&lt;br&gt;merged with RRF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="240" y="72" width="228" height="108" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;b&gt;cross-encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;reranks the top-12&lt;br&gt;calibrated relevance 0–1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="504" y="72" width="228" height="108" as="geometry"/></mxCell>
<mxCell id="q4" value="threshold 0.35" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="768" y="66" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;ollama (default) · Anthropic&lt;br&gt;or extractive, no model&lt;br&gt;&lt;br&gt;receives numbered passages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="996" y="72" width="228" height="108" as="geometry"/></mxCell>
<mxCell id="q6" value="&lt;b&gt;verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;markers → supplied passages&lt;br&gt;ECLI must match&lt;br&gt;in code, not in the prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="1260" y="72" width="228" height="108" as="geometry"/></mxCell>
<mxCell id="q7" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;claims +&lt;br&gt;citations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="1524" y="72" width="108" height="108" as="geometry"/></mxCell>
<mxCell id="q8" value="&lt;b&gt;NO SOURCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;the language model is not even called&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=1.5;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="744" y="222" width="228" height="72" as="geometry"/></mxCell>
<mxCell id="q9" value="&lt;b&gt;rejected claims&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;are shown, not hidden&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef4444;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="on"><mxGeometry x="1236" y="222" width="276" height="72" as="geometry"/></mxCell>
<mxCell id="cli" value="CLI: ingest · index · ask · eval · stats · demo&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; ask --json is what the evaluation reads &amp;nbsp;|&amp;nbsp;&amp;nbsp; 93 tests in CI with no network, no model, no LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#6b7280;arcSize=6;" vertex="1" parent="1"><mxGeometry x="48" y="636" width="1656" height="36" as="geometry"/></mxCell>
