<mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="700" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="De agent-graph — één beurt, van vraag tot antwoord" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Routering, guards, toolexecutie en verificatie zijn gewone Python. Eén node praat met een model — de rest is deterministisch en dus testbaar." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1000" height="20" as="geometry"/></mxCell>
<mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="guard" value="guard_input&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;dagbudget bereikt?&lt;br&gt;prompt-injectie?&lt;br&gt;kaart- of rekeningnummer?&lt;br&gt;duidelijk off-topic?&lt;br&gt;&lt;br&gt;reset de per-run state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="180" y="285" width="210" height="150" as="geometry"/></mxCell>
<mxCell id="refuse" value="refuse&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;beleefde weigering,&lt;br&gt;zonder één token uit te geven&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="end1" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="gen" value="generate&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;de enige node die een model aanroept&lt;br&gt;&lt;br&gt;streamt tekst · verzamelt citaties&lt;br&gt;telt tokens en kosten op&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="appr" value="request_approval&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;interrupt(): de graph pauzeert&lt;br&gt;en wordt gecheckpoint&lt;br&gt;de bezoeker krijgt een melding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#8a4d03;" vertex="1" parent="1"><mxGeometry x="740" y="100" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="exec" value="execute_tools&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;deterministische Python, met timeout&lt;br&gt;hoog-risico zonder goedkeuring&lt;br&gt;wordt geweigerd, niet uitgevoerd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="740" y="285" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="verify" value="verify&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;kosten bij het budget&lt;br&gt;lang antwoord zonder&lt;br&gt;citatie → gemarkeerd&lt;br&gt;trace naar de client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="1"><mxGeometry x="1030" y="285" width="180" height="150" as="geometry"/></mxCell>
<mxCell id="end2" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1075" y="510" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="note1" value="Elke node schrijft zijn eigen latency in de trace; die gaat als diagnostisch event mee naar de browser." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="note2" value="Na drie toolrondes wordt tool_choice op &quot;none&quot; gezet:&lt;br&gt;het model moet dan in tekst antwoorden. Geen&lt;br&gt;oneindige lus, ook niet als het model blijft aandringen." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="450" y="580" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#555555;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" value="guard afgegaan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="guard" target="refuse"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="refuse" target="end1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" value="anders" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#555555;strokeWidth=3;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="guard" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f5" value="hoog-risico tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b46504;strokeWidth=3;endArrow=block;fontSize=10;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="appr"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f6" value="gewone tool" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f7" value="besluit van Ruud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b46504;strokeWidth=3;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="appr" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f8" value="toolresultaten terug — maximaal 3 rondes" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="exec" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="855" y="530"/><mxPoint x="565" y="530"/></Array></mxGeometry></mxCell>
<mxCell id="f9" value="geen tools meer" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=3;endArrow=block;fontSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="verify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="263"/><mxPoint x="1000" y="263"/></Array></mxGeometry></mxCell>
<mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="verify" target="end2"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel>
