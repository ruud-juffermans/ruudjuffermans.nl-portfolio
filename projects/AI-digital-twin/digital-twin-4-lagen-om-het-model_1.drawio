<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Wat er om het model heen staat" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Het model is het enige onderdeel dat kan improviseren. Alles ervoor en erna is deterministische Python — en faalt dicht: bij twijfel geen antwoord in plaats van een gokje." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1100" height="20" as="geometry"/></mxCell>
<mxCell id="q" value="vraag" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="90" height="60" as="geometry"/></mxCell>
<mxCell id="b1" value="1 · TRANSPORT&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;20 verzoeken per 10 minuten&lt;br&gt;per IP-adres&lt;br&gt;&lt;br&gt;pydantic-validatie: rol, lengte,&lt;br&gt;maximaal 40 beurten, laatste&lt;br&gt;beurt moet van de bezoeker zijn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="b2" value="2 · BUDGET&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;dagplafond in dollars&lt;br&gt;&lt;br&gt;bereikt = beleefde weigering&lt;br&gt;vóórdat er één token&lt;br&gt;wordt uitgegeven&lt;br&gt;&lt;br&gt;overleeft een herstart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="b3" value="3 · INPUT GUARDS&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;prompt-injectie&lt;br&gt;kaart- en rekeningnummers&lt;br&gt;duidelijk off-topic verzoek&lt;br&gt;&lt;br&gt;plain Python, geen model&lt;br&gt;dat over zichzelf oordeelt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="model" value="MODEL&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;system prompt + volledige&lt;br&gt;kennisbank, in vaste volgorde&lt;br&gt;&lt;br&gt;het enige onderdeel&lt;br&gt;dat kan improviseren&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="190" height="180" as="geometry"/></mxCell>
<mxCell id="b4" value="4 · CITATIECONTROLE&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;een citatie wordt alleen&lt;br&gt;doorgegeven als de genoemde&lt;br&gt;titel echt in de kennisbank staat&lt;br&gt;&lt;br&gt;anders: stil laten vallen&lt;br&gt;en markeren&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="1"><mxGeometry x="980" y="140" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="b5" value="5 · GROUNDEDNESS&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;lang, stellig antwoord&lt;br&gt;zonder één citatie&lt;br&gt;en zonder toolresultaat&lt;br&gt;&lt;br&gt;→ gemarkeerd voor&lt;br&gt;handmatige review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#5f3d73;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="tools" value="TOOLCONTRACT&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;strikt JSON Schema: elke property verplicht, geen extra velden · argumenten altijd geparsed, nooit op tekst gematcht&lt;br&gt;elke tool heeft een timeout · een tool die faalt geeft een nette foutmelding terug in plaats van de beurt te laten crashen&lt;br&gt;&lt;b&gt;draft_contact_message is hoog risico en draait nooit zonder expliciete goedkeuring van Ruud&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="790" height="120" as="geometry"/></mxCell>
<mxCell id="tel" value="VASTGELEGD PER BEURT — turn_log (uitkomst, tokens, kosten, latency) · guard_incidents · unanswered_questions · budget_ledger · feedback van bezoekers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9a3b37;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1310" height="70" as="geometry"/></mxCell>
<mxCell id="ev" value="EVALS — twee gelabelde datasets draaien tegen de échte graph: toolkeuze (drempel 95%) en taakafronding (drempel 90%). Met --failure-injection wordt elk tweede HTTP-verzoek gedropt; de retries moeten dat opvangen, anders zakt de run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1310" height="70" as="geometry"/></mxCell>
