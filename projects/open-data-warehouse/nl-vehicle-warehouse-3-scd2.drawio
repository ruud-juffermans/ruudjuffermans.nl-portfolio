<mxCell id="title" value="SCD type 2: het cijfer hangt aan de gemeente van tóen" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="Nederland herindeelt bijna elk jaar. Het verschil tussen twee CBS-gebiedsbestanden ís de mutatie die de dimensie moet vastleggen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="20" as="geometry"/></mxCell>
<mxCell id="bron" value="BRON — CBS Gebieden in Nederland" style="swimlane;rounded=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;fontStyle=1;fontSize=11;startSize=26;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="270" as="geometry"/></mxCell>
<mxCell id="b1" value="één bestand per peiljaar&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;2015 t/m 2026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;fontSize=11;fontStyle=1;" vertex="1" parent="bron"><mxGeometry x="20" y="36" width="210" height="50" as="geometry"/></mxCell>
<mxCell id="b2" value="2015 · 393 gemeenten&lt;br&gt;2018 · 380&amp;nbsp; (+3 / −11)&lt;br&gt;2019 · 355&amp;nbsp; (+9 / −34)&lt;br&gt;2023 · 342&amp;nbsp; (+1 / −4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="bron"><mxGeometry x="20" y="98" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="b3" value="het verschil tussen twee jaren = de herindeling" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="bron"><mxGeometry x="20" y="200" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="dim" value="dim_gemeente — SCD type 2" style="swimlane;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;startSize=28;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="420" height="270" as="geometry"/></mxCell>
<mxCell id="hdr" value="gemeente_key&amp;nbsp; |&amp;nbsp; naam&amp;nbsp; |&amp;nbsp; geldig_van&amp;nbsp; |&amp;nbsp; geldig_tot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#9a3b37;spacingLeft=10;" vertex="1" parent="dim"><mxGeometry x="20" y="34" width="380" height="24" as="geometry"/></mxCell>
<mxCell id="v1" value="&lt;b&gt;versie 1&lt;/b&gt;&amp;nbsp;&amp;nbsp; Haaren&amp;nbsp;&amp;nbsp; 2015-01-01 → 2020-12-31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="dim"><mxGeometry x="20" y="62" width="380" height="48" as="geometry"/></mxCell>
<mxCell id="v2" value="&lt;b&gt;versie 2&lt;/b&gt;&amp;nbsp;&amp;nbsp; Oisterwijk&amp;nbsp;&amp;nbsp; 2021-01-01 → 9999-12-31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="dim"><mxGeometry x="20" y="120" width="380" height="48" as="geometry"/></mxCell>
<mxCell id="how" value="Opgebouwd met lag() over peiljaar per gemeente_code:&lt;br&gt;elke naamswijziging start een nieuwe versie, en de&lt;br&gt;lopende som over die markeringen is het versienummer.&lt;br&gt;Eigen tests bewaken dat perioden aaneengesloten zijn,&lt;br&gt;niet overlappen en er hoogstens één actuele versie is." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#9a3b37;fontStyle=2;spacingLeft=6;" vertex="1" parent="dim"><mxGeometry x="20" y="180" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="fct" value="fct_voertuigpark_gemeente" style="swimlane;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;startSize=28;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="290" height="270" as="geometry"/></mxCell>
<mxCell id="f1" value="peiljaar &lt;b&gt;2016&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;aantal personenauto's&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fct"><mxGeometry x="20" y="42" width="250" height="52" as="geometry"/></mxCell>
<mxCell id="f2" value="peiljaar &lt;b&gt;2023&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;aantal personenauto's&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="fct"><mxGeometry x="20" y="120" width="250" height="52" as="geometry"/></mxCell>
<mxCell id="f3" value="Elke feitrij krijgt de surrogaatsleutel&lt;br&gt;van de versie die op 1 januari van&lt;br&gt;dat peiljaar geldig was." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#3b5a86;fontStyle=2;spacingLeft=6;" vertex="1" parent="fct"><mxGeometry x="20" y="188" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="join" value="de temporele join&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;on gemeente_code = gemeente_code&lt;br&gt;and make_date(peiljaar,1,1)&lt;br&gt;between geldig_van and geldig_tot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="290" height="90" as="geometry"/></mxCell>
<mxCell id="fout" value="Zonder type 2&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;zou het cijfer van 2016 aan de&lt;br&gt;huidige gemeente hangen — historische&lt;br&gt;stuurinformatie verschuift dan met&lt;br&gt;terugwerkende kracht, zonder foutmelding.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8c8c8c;strokeWidth=1;dashed=1;fontSize=11;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="850" y="420" width="290" height="110" as="geometry"/></mxCell>
