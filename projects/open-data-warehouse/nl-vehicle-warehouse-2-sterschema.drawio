<mxCell id="fct2" value="fct_voertuigpark_gemeente&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;br&gt;PERIODIEKE SNAPSHOT&lt;br&gt;grain: één gemeente per peiljaar&lt;br&gt;per voertuigsoort&lt;br&gt;&lt;br&gt;maat: aantal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#2d4b73;" vertex="1" parent="1"><mxGeometry x="450" y="420" width="280" height="170" as="geometry"/></mxCell>
