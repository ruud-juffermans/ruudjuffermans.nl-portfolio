<mxCell id="sub" value="Twee feiten met een verschillende grain in één model. Elke dimensie hangt aan de feiten via een surrogaatsleutel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="20" as="geometry"/></mxCell>
