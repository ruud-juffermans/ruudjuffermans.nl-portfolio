<mxCell id="bridge" value="bridge_voertuig_brandstof&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;12.671 voertuigen hebben&lt;br&gt;meer dan één brandstof&lt;br&gt;— voorkomt dubbeltellen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#8a6400;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="220" height="100" as="geometry"/></mxCell>
