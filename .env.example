# ─────────────────────────────────────────────────────────────────────────────
# Portfolio site — client-only. The site's backend (contact / newsletter /
# analytics + admin) lives in ../ruudjuffermans-server (api.ruudjuffermans.nl)
# as the "website" module; CONTACT_EMAIL, NEWSLETTER_API_KEY, SMTP_* and
# ADMIN_SERVICE_TOKEN live in that project's env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Client (Next.js; NEXT_PUBLIC_* is baked in at build time) ---
# Platform API origin. Leave EMPTY in dev: the browser then calls same-origin
# /api/* and next.config.ts rewrites it to the local platform server on :4000.
NEXT_PUBLIC_API_URL=
# Canonical site URL (metadata + www→apex redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The central account app (the header's "log in" button links there). Unset
# defaults to https://account.ruudjuffermans.nl; for local dev use
# http://localhost:3004.
NEXT_PUBLIC_ACCOUNT_URL=
# The running digital-twin assistant (https://ai.ruudjuffermans.nl in
# production). Leave EMPTY to switch it off. When set: the "Try it live"
# buttons on the digital-twin project page and the homepage render, every page
# loads the twin's floating chat widget (its iframe opens on first click), and
# the production CSP allows that origin in script-src and frame-src.
NEXT_PUBLIC_TWIN_URL=
